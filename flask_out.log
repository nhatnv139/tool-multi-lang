[DEBUG-TTS] synth_azure nhan duoc 14688 bytes
  [68/90] sentence      3.0s
[DEBUG-TTS] synth_azure text='一页一页，一天一天，你心里的土慢慢变软，长出别人看不见的根。' len=30 key_len=84 region='southeastasia'
[DEBUG-TTS] synth_azure goi voice='zh-CN-Yunfan:DragonHDLatestNeural' region='southeastasia' url='https://southeastasia.tts.speech.microsoft.com/cognitiveservices/v1'
[DEBUG-TTS] synth_azure nhan duoc 41616 bytes
  [69/90] sentence      8.0s
[DEBUG-TTS] synth_azure text='如果你也想开始，不用发誓，也不用一次买十本书。' len=23 key_len=84 region='southeastasia'
[DEBUG-TTS] synth_azure goi voice='zh-CN-Yunfan:DragonHDLatestNeural' region='southeastasia' url='https://southeastasia.tts.speech.microsoft.com/cognitiveservices/v1'
[DEBUG-TTS] synth_azure nhan duoc 26640 bytes
  [70/90] sentence      5.2s
[DEBUG-TTS] synth_azure text='你只需要做三件小事。' len=10 key_len=84 region='southeastasia'
[DEBUG-TTS] synth_azure goi voice='zh-CN-Yunfan:DragonHDLatestNeural' region='southeastasia' url='https://southeastasia.tts.speech.microsoft.com/cognitiveservices/v1'
[DEBUG-TTS] synth_azure nhan duoc 11952 bytes
  [71/90] sentence      2.5s
[DEBUG-TTS] synth_azure text='第一，把数字定小：每晚十页，太累的晚上五页，但不要是零页。' len=29 key_len=84 region='southeastasia'
[DEBUG-TTS] synth_azure goi voice='zh-CN-Yunfan:DragonHDLatestNeural' region='southeastasia' url='https://southeastasia.tts.speech.microsoft.com/cognitiveservices/v1'
[DEBUG-TTS] synth_azure nhan duoc 43632 bytes
  [72/90] sentence      8.4s
[DEBUG-TTS] synth_azure text='第二，把书放在床头，把手机放在够不着的地方，让你的手先碰到书。' len=31 key_len=84 region='southeastasia'
[DEBUG-TTS] synth_azure goi voice='zh-CN-Yunfan:DragonHDLatestNeural' region='southeastasia' url='https://southeastasia.tts.speech.microsoft.com/cognitiveservices/v1'
[DEBUG-TTS] synth_azure nhan duoc 44928 bytes
  [73/90] sentence      8.6s
