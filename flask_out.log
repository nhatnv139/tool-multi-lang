[DEBUG-TTS] synth_azure goi voice='zh-CN-Yunfan:DragonHDLatestNeural' region='southeastasia' url='https://southeastasia.tts.speech.microsoft.com/cognitiveservices/v1'
[DEBUG-TTS] synth_azure nhan duoc 21600 bytes
  [74/90] sentence      4.6s
[DEBUG-TTS] synth_azure text='你以为忘了的那些句子，其实会变成你说话的样子、做事的样子。' len=29 key_len=84 region='southeastasia'
[DEBUG-TTS] synth_azure goi voice='zh-CN-Yunfan:DragonHDLatestNeural' region='southeastasia' url='https://southeastasia.tts.speech.microsoft.com/cognitiveservices/v1'
[DEBUG-TTS] synth_azure nhan duoc 31248 bytes
  [75/90] sentence      6.1s
