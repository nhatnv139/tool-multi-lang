[DEBUG-TTS] synth_azure goi voice='zh-CN-Yunfan:DragonHDLatestNeural' region='southeastasia' url='https://southeastasia.tts.speech.microsoft.com/cognitiveservices/v1'
[DEBUG-TTS] synth_azure nhan duoc 25776 bytes
  [76/90] sentence      5.1s
[DEBUG-TTS] synth_azure text='断了一天也没关系，第二天翻开，从停下的地方继续。' len=24 key_len=84 region='southeastasia'
[DEBUG-TTS] synth_azure goi voice='zh-CN-Yunfan:DragonHDLatestNeural' region='southeastasia' url='https://southeastasia.tts.speech.microsoft.com/cognitiveservices/v1'
[DEBUG-TTS] synth_azure nhan duoc 30240 bytes
  [77/90] sentence      6.4s
